# Settings of tools/eukore.sh (bash, sourced by it on the login node and inside every job): copy to
# local/eukore.conf of the checkout (git ignores local/), or to the file $EUKORE_CONF names.

PDIR=/path/to/Eukore                  # the checkout: eukore_build.py
WORK=/path/to/build/Eukore            # --build_dir: the build's own state, on a file system that keeps its files
OUT=/path/to/DB/Eukore                # --out: the package and its release
GEN=/path/to/DB/genomes               # --genomes: the genomes' folder (empty: OUT/genomes)
SOURCES=/path/to/DB/Eukore/sources    # --sources: what the fetch stage downloads (NCBI's taxonomy, BUSCO's dataset,
                                      # ...), kept between builds (empty: WORK/sources)
LOGS=$PDIR/runs                       # the jobs' STDOUT and STDERR (empty: sbatch's own, the folder of the call),
                                      # named by their step: fetch.<job>, process.<array>_<task>, final.<job>,
                                      # qc.<array>_<task> (.otxt, .etxt)
VERSION=2026.11                       # --version, fixed: its default is the month of each run's day, and a build
                                      # that crosses a month's end would write a second Eukore_<version>
MAMBA_ENV=eukore                      # the micromamba environment with Eukore's tools
TIARA_ENV=eukore-tiara                # tiara's own environment (envs/tiara.yaml: it needs Python <= 3.9), given to
                                      # the build as --tiara <env>/bin/tiara; TIARA=/path/to/tiara names the program
                                      # itself. Without either, the build classifies no windows
TASKS=8                               # process jobs of the array (`build N` gives another number)
QC_TASKS=8                            # helper jobs of the package stage's vsearch checks across species, which the
                                      # final job submits once their inputs are written (0: the final job alone)
QC_IDLE=1800                          # seconds a helper waits for the final job's next search once none is left
                                      # (since 2026-11-15: one helper array serves every search of the final job;
                                      # the final job submits another where none is left, and stops them at its end)

# a node's local disk for temporary files (--local_tmp); read inside the job, where SLURM names it
SCR=${SLURM_LOCAL_SCRATCH:+$SLURM_LOCAL_SCRATCH/Eukore}

# the comparisons with other references (EukDetect2, MetaPhlAn 4, PR2), the read benchmark and the figures:
# benchmarks/README.md, on the finished package (since 2026-11-12; until then COMPARE, MPA_* and EUKDETECT_* here),
# `bash tools/eukore.sh bench_downloads`, then `AFTER=<its job> bash tools/eukore.sh benchmark` (since 2026-11-17;
# since 2026-11-19 `build` and `final` submit both after the final job where BENCH is set),
# in MAMBA_ENV (envs/eukore.yaml holds their tools)
BENCH=/path/to/DB/Eukore/bench       # the other references, kept between builds (~9 GB): their downloads, their
                                      # comparable forms (compare/), the read benchmark's genomes; on a file system
                                      # that keeps its files, not scratch
BENCH_RESULTS=                        # the tables and figures (empty: OUT/Eukore_<VERSION>_benchmarks)
BENCH_AFTER_FINAL=1                   # 1: `build` and `final` link the benchmark jobs after the final job; 0: not
BENCH_DOWNLOADS_OPTS=()               # eukore_bench.prep's: --read_genomes N, --mpa_version, --only pr2,...
BENCH_OPTS=()                         # eukore_bench.compare's: --no_tree, --previous OUT/Eukore_<older version>, --only reads (one step alone: the results in the folder kept), --read_low (the read benchmark keeps the low-confidence records)
FIGURE_OPTS=()                        # eukore_bench.figures': --format pdf
SBATCH_BENCH_DOWNLOADS=()             # bench_downloads' job (empty: SBATCH_FETCH's; needs the internet)
SBATCH_BENCH=(-p medium --cpus-per-task=32 --mem=200G --localscratch=ssd:200)  # benchmark's (empty:
                                      # SBATCH_PROCESS'); minimap2 on the whole package: tens of GB

# eukore_build.py's options: every stage's (the same --groups, --species for each), the fetch job's, the final job's
# (-t is the job's --cpus-per-task). --ksgp_tax: a KSGP release's tax file, species.tsv's KSGP lineages and
# taxonomy/links.tsv's KSGP records (protal's KSGP; default KSGP's served 4.0). Since 2026-11-14 (format 7) KSGP and
# PR2 give no record: the published 18S are EUKARYOME's alone, audited by the build (eukore/audit.py, chimeras.py;
# its window screen needs minimap2, QC_TASKS' helpers take its parts and UCHIME's)
BUILD_OPTS=(--ksgp_tax /path/to/KSGP_v5.2/KSGP_v5.2_plus2.tax)
FETCH_OPTS=(--downloads 12)
FINAL_OPTS=(--keep_gb 1000)
# protal's genome sketch of the package's species (since 2026-11-19): the final job makes it before the prune with
# protal's own binary, metadata/protal_sketch.bin (none without --protal): about 5,000 entries for a genome of 500 Mb
# (--protal_sketch_kmers, --protal_sketch_mb), 1,000 to 100,000 a species; for all eukaryotes ~3.4 GB, and ~20 GB of
# the final job's memory while it runs:
# FINAL_OPTS=(--keep_gb 1000 --protal /path/to/protal/build/protal)

# sbatch's options: every job's, then each kind's. A list of partitions (-p a,b,c) is refused whole when one of
# them refuses the job: try each alone with `sbatch --test-only` (a large-memory partition may refuse a small job)
SBATCH_ALL=(--time=124:00:00)
SBATCH_FETCH=(-p download --cpus-per-task=2 --mem=8G)
SBATCH_PROCESS=(-p medium --cpus-per-task=64 --mem=200G --localscratch=ssd:500)
SBATCH_FINAL=(-p largemem --cpus-per-task=92 --mem=839000 --localscratch=ssd:500)
SBATCH_QC=(-p medium --cpus-per-task=64 --mem=64G --time=24:00:00)   # a locus' search: ~10 GB at 30,000 copies
# (a helper searches on its --cpus-per-task threads, whatever their number: 16 or 32 with 32G are enough where 64-core
# jobs wait long or are refused; its --time must cover the final job's searches, QC_IDLE apart. Try a setting from
# the login node with `bash tools/eukore.sh qc 1`: sbatch says why it refuses one.)
